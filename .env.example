# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# All of these are OPTIONAL and only used by the Phase 2 email notification
# (tools/notify.py -> send_email). Phase 1 writes a plain notification file and
# needs none of them.

# Label shown in the notification header (defaults to "Fuel Pricing")
COMPANY_NAME=

# SMTP server for daily email notifications (Phase 2)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=change-me

# Notification addresses
NOTIFY_FROM=you@example.com
NOTIFY_TO=team@example.com
